# Configuração do Pop AI (copie para .env.local, que não vai para o GitHub).
# Chave grátis em https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=
# Opcional: outro modelo do Gemini
VITE_GEMINI_MODELO=
# Só para testes: servidor próprio que apresenta o celular-leitor ao computador
# (host:porta de um servidor PeerJS). Sem ele, usa o servidor gratuito do PeerJS.
VITE_LEITOR_SINAL=
